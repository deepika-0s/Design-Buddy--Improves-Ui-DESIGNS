# ─────────────────────────────────────────────
#  DesignBuddy — Server Environment Variables
# ─────────────────────────────────────────────

# Your Google AI Studio API key (get one free at aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key-here

# Port the Express server runs on
PORT=3001

# Frontend URL for CORS (update for production)
CLIENT_URL=http://localhost:5173

# Max file size for uploads in MB
MAX_FILE_SIZE_MB=10

# Max images per request
MAX_IMAGES_PER_REQUEST=5

# Rate limiting: max requests per IP per 15 minutes
RATE_LIMIT_MAX=30
